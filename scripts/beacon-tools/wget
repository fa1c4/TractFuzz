#!/usr/bin/env python3
"""Use packaged Autotools helpers for libtiff's old Savannah download."""

import glob
import os
import shutil
import sys

args = sys.argv[1:]
url = args[-1] if args else ""
prefix = "https://git.savannah.gnu.org/cgit/config.git/plain/"
if url.startswith(prefix) and "-O" in args:
    name = url[len(prefix):]
    if name in ("config.guess", "config.sub"):
        installed = sorted(glob.glob(f"/usr/share/automake-*/{name}"))
        if not installed:
            raise SystemExit(f"No installed Autotools {name}")
        shutil.copy2(installed[-1], args[args.index("-O") + 1])
        raise SystemExit(0)
os.execv("/usr/bin/wget", ["/usr/bin/wget", *args])
